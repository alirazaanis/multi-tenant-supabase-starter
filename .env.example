# Supabase project credentials (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Service role key — server-only; rate limits and idempotency in production.
# Also required for the /problem naive-signup illustration (development).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Auth Hook request verification (Dashboard → Auth → Hooks)
SUPABASE_AUTH_HOOK_SECRET=
